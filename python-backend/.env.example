# LobeHub Python Backend — Environment Configuration
# Copy to .env and fill in your values.

# ── General ──────────────────────────────────────────────────────────
DEBUG=true
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:lobechat@localhost:5433/lobehub

# ── Auth (Keycloak / OIDC) ──────────────────────────────────────────
# Leave unset to disable auth (development mode)
# AUTH_OIDC_ISSUER=https://keycloak.example.com/realms/lobehub
# AUTH_OIDC_CLIENT_ID=lobehub-backend

# ── Key Vault ────────────────────────────────────────────────────────
# Fernet key for encrypting provider API keys stored in DB
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KEY_VAULTS_SECRET=

# ── S3 / MinIO ──────────────────────────────────────────────────────
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=lobehub
# S3_REGION=us-east-1
# S3_PUBLIC_DOMAIN=

# ── LLM ──────────────────────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_PROXY_URL=

# ── AWS Bedrock ──────────────────────────────────────────────────────
# Use model strings like: bedrock/us.anthropic.claude-sonnet-4-20250514-v1:0
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Embedding ────────────────────────────────────────────────────────
# EMBEDDING_BATCH_SIZE=50
# EMBEDDING_CONCURRENCY=10

# ── Web Search ───────────────────────────────────────────────
# Supported: tavily, searxng, serper
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=
# SEARXNG_URL=http://localhost:8888
# SERPER_API_KEY=

# ── Code Interpreter ──────────────────────────────────────────
# CODE_INTERPRETER_ENABLED=true
# CODE_INTERPRETER_TIMEOUT=30

# ── Langfuse (tracing) ───────────────────────────────────────────────
# Get keys from https://cloud.langfuse.com or self-hosted instance
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_ENABLED=false

# ── Agent Runtime ────────────────────────────────────────────────────
# AGENT_MAX_STEPS=25
# AGENT_REQUIRE_HUMAN_APPROVAL=false

# ── Content Policy ───────────────────────────────────────────────────
# CONTENT_POLICY_ENABLED=false
# CONTENT_POLICY_USE_MODERATION_API=false    # Use OpenAI Moderation API (requires OPENAI_API_KEY)
# CONTENT_POLICY_CHECK_OUTPUT=true           # Also check LLM output (not just input)
# CONTENT_POLICY_BLOCKED_PATTERNS=           # Comma-separated regex patterns for keyword blocklist

# ── Feature Flags ────────────────────────────────────────────────────
# Comma-separated: "+flag_name" to enable, "-flag_name" to disable
# FEATURE_FLAGS=
